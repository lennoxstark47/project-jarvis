<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jarvis.agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>__JARVIS_APP_BINARY__</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
    <key>EnvironmentVariables</key>
    <dict>
        <key>JARVIS_RUN_SCRIPT</key>
        <string>__JARVIS_PROJECT_ROOT__/run.py</string>
        <key>PYTHONPATH</key>
        <string>__JARVIS_APP_RESOURCES__:__JARVIS_VENV_SITE_PACKAGES__</string>
    </dict>
    <key>StandardOutPath</key>
    <string>__JARVIS_PROJECT_ROOT__/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__JARVIS_PROJECT_ROOT__/logs/launchd.err.log</string>
</dict>
</plist>
