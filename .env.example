# Jarvis environment — copy to `.env` and edit. Everything here overrides
# config/jarvis.json, which overrides src/jarvis/config.py's DEFAULTS.
# `.env` is gitignored; `.env.example` is not, so keep real keys out of it.

# ---- which brain answers -----------------------------------------------
# One of: claude | openai | nvidia | openrouter | ollama, or any provider you
# added under `backends` in config/jarvis.json with a base_url.
JARVIS_BACKEND=openrouter

# Model for whichever backend JARVIS_BACKEND names. Leave unset to use that
# backend's configured model. Careful: it FOLLOWS the switch — set it and then
# flip JARVIS_BACKEND to ollama, and Ollama gets asked for this model id. Use
# the per-backend form below unless you actually want that.
#JARVIS_MODEL=nex-agi/nex-n2.5-mini:free

# Per-backend overrides. These stay put when you switch backends, so it's the
# safer place to pin a model id:
#JARVIS_OPENROUTER_MODEL=nex-agi/nex-n2.5-mini:free
#JARVIS_NVIDIA_MODEL=openai/gpt-oss-20b
#JARVIS_OLLAMA_MODEL=granite4.1:3b
#JARVIS_OLLAMA_HOST=http://192.168.1.110:11434
#JARVIS_CLAUDE_MODEL=claude-opus-5

# ---- keys (never committed) --------------------------------------------
# Read from here first, then secrets/api_keys.json.
#OPENROUTER_API_KEY=sk-or-v1-...
#NVIDIA_API_KEY=nvapi-...
#ANTHROPIC_API_KEY=sk-ant-...
#OPENAI_API_KEY=sk-...

# ---- occasional knobs ---------------------------------------------------
#JARVIS_SPEECH_ENABLED=false
#JARVIS_SPEECH_VOICE=Karen
#JARVIS_ALLOW_EDITS=false

# ---- Phase 7: sub-agents ------------------------------------------------
# The research lane shells out to the `claude` CLI with only WebSearch and
# WebFetch enabled, in a throwaway directory. Off means the `research` tool
# says lookups are disabled rather than answering from memory.
#JARVIS_RESEARCH_ENABLED=false
# A lookup runs on whatever model the CLI defaults to. Pin a cheaper one here
# if lookups add up — measured 2026-09-09: ~$0.12 and 32s for a three-search
# question on the default.
#JARVIS_RESEARCH_MODEL=claude-haiku-4-5
#JARVIS_RESEARCH_TIMEOUT=180
# Per-lane brains (config/jarvis.json → agents.routing.backends). Off means
# every lane uses JARVIS_BACKEND, exactly as before Phase 7.
#JARVIS_ROUTING_ENABLED=false
